{
  "elements": [
    {
      "type": "ValidationTextBox",
      "name": "Host",
      "caption": "Miniserver IP / Host"
    },
    {
      "type": "NumberSpinner",
      "name": "Port",
      "caption": "Port",
      "minimum": 1,
      "maximum": 65535
    },
    {
      "type": "CheckBox",
      "name": "UseHttps",
      "caption": "HTTPS verwenden"
    },
    {
      "type": "ValidationTextBox",
      "name": "Username",
      "caption": "Benutzer"
    },
    {
      "type": "PasswordTextBox",
      "name": "Password",
      "caption": "Passwort"
    },
    {
      "type": "NumberSpinner",
      "name": "PollingInterval",
      "caption": "Polling-Intervall Sekunden (0 = aus)",
      "minimum": 0,
      "maximum": 3600
    },
    {
      "type": "NumberSpinner",
      "name": "LiveEngineInterval",
      "caption": "LiveEngine-Zyklus Sekunden (0 = aus)",
      "minimum": 0,
      "maximum": 3600
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Verbindung testen",
      "onClick": "echo LOX_TestConnection($id);"
    },
    {
      "type": "Button",
      "caption": "Miniserver auslesen",
      "onClick": "echo LOX_ReadMiniserver($id);"
    },
    {
      "type": "Button",
      "caption": "Controls importieren / aktualisieren",
      "onClick": "echo LOX_ImportControls($id);"
    },
    {
      "type": "Button",
      "caption": "Geräte-Instanzen erzeugen / aktualisieren",
      "onClick": "echo LOX_ImportDeviceInstances($id);"
    },
    {
      "type": "Button",
      "caption": "Statuswerte aktualisieren",
      "onClick": "echo LOX_RefreshAllDeviceStates($id);"
    },
    {
      "type": "Button",
      "caption": "State-Index erstellen",
      "onClick": "echo LOX_BuildStateIndex($id);"
    },
    {
      "type": "Button",
      "caption": "LiveEngine Test: HTTP-Snapshot",
      "onClick": "echo LOX_RefreshIndexedStateValues($id);"
    },
    {
      "type": "Button",
      "caption": "WebSocket vorbereiten",
      "onClick": "echo LOX_GetWebSocketInfo($id);"
    },
    {
      "type": "Button",
      "caption": "WebSocket Handshake testen",
      "onClick": "echo LOX_TestWebSocketHandshake($id);"
    },
    {
      "type": "Button",
      "caption": "WebSocket Command testen",
      "onClick": "echo LOX_TestWebSocketCommand($id);"
    },
    {
      "type": "Button",
      "caption": "Token Auth testen",
      "onClick": "echo LOX_TestTokenAuthentication($id);"
    },
    {
      "type": "Button",
      "caption": "WebSocket Token Auth testen",
      "onClick": "echo LOX_TestWebSocketAuthCommand($id);"
    },
    {
      "type": "Button",
      "caption": "LiveEngine Probe starten",
      "onClick": "echo LOX_TestWebSocketLiveProbe($id);"
    },
    {
      "type": "Button",
      "caption": "LiveEngine Decoder Probe",
      "onClick": "echo LOX_TestWebSocketDecodeProbe($id);"
    },
    {
      "type": "Button",
      "caption": "LiveEngine Automatik-Zyklus testen",
      "onClick": "echo LOX_RunLiveEngineCycle($id);"
    },
    {
      "type": "Label",
      "caption": "Sprint 17: LiveEngine-Zyklus mit WebSocket-Decoder, Überlappungsschutz, Statusvariablen und Command-Status."
    }
  ]
}