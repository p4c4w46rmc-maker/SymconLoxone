{
  "elements": [
    {
      "type": "ValidationTextBox",
      "name": "Host",
      "caption": "Miniserver IP / Host"
    },
    {
      "type": "NumberSpinner",
      "name": "Port",
      "caption": "Port",
      "minimum": 1,
      "maximum": 65535
    },
    {
      "type": "CheckBox",
      "name": "UseHttps",
      "caption": "HTTPS verwenden"
    },
    {
      "type": "ValidationTextBox",
      "name": "Username",
      "caption": "Benutzer"
    },
    {
      "type": "PasswordTextBox",
      "name": "Password",
      "caption": "Passwort"
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Verbindung testen",
      "onClick": "echo LOX_TestConnection($id);"
    },
    {
      "type": "Button",
      "caption": "Miniserver auslesen",
      "onClick": "echo LOX_ReadMiniserver($id);"
    },
    {
      "type": "Button",
      "caption": "Controls importieren / aktualisieren",
      "onClick": "echo LOX_ImportControls($id);"
    },
    {
      "type": "Button",
      "caption": "Geräte-Instanzen erzeugen / aktualisieren",
      "onClick": "echo LOX_ImportDeviceInstances($id);"
    },
    {
      "type": "Label",
      "caption": "Sprint 5: Erzeugt echte Loxone Device-Instanzen je Control. Live-Werte und Steuerbefehle folgen im nächsten Schritt."
    }
  ]
}
