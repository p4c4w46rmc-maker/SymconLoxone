{
  "elements": [
    {
      "type": "Label",
      "caption": "Loxone Device. Diese Instanz wird automatisch vom Loxone Gateway erzeugt."
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Metadaten aktualisieren",
      "onClick": "echo LOXD_RefreshMetadata($id);"
    },
    {
      "type": "Button",
      "caption": "Statuswerte aktualisieren",
      "onClick": "echo LOXD_RefreshStateValues($id);"
    },
    {
      "type": "Button",
      "caption": "Standardbefehl testen",
      "onClick": "echo LOXD_TestCommand($id);"
    },
    {
      "type": "Label",
      "caption": "Sprint 11: Pushbutton/Switch über ActionUUID steuern. Aktive Variable ist bei Switch/Pushbutton bedienbar."
    }
  ]
}